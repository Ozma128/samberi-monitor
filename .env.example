# API ключи для Vision AI распознавания ценников
# Укажите один из ключей (Google Gemini предпочтителен по скорости и цене)

# Google Gemini API Key (получить бесплатно на https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Либо OpenAI API Key (если используется GPT-4o-mini)
OPENAI_API_KEY=your_openai_api_key_here

# (Опционально) Telegram Bot Token для мобильного сбора ценников
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
