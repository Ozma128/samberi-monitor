# Скопируйте файл в .env только для локальной разработки.
# Никогда не коммитьте .env, ключи и токены.

# Обязательно для реального OCR. Создайте отдельный ключ проекта и ограничьте
# его квоты/доступ в Google AI Studio или Google Cloud.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Параметры обработки; допустимые диапазоны: 50–100, 1–4 и 0–1.
MATCH_THRESHOLD=72
VISION_WORKERS=2
MIN_RECOGNITION_CONFIDENCE=0.55

# Необязательная конфигурация Telegram-бота. Все значения ниже (а также
# GEMINI_API_KEY выше) должны быть заполнены, иначе бот безопасно не запустится.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
SAMBERI_CATALOG_PATH=

# Необязательный уровень журналирования Telegram-бота.
LOG_LEVEL=INFO
